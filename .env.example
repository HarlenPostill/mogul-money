# Firebase Realtime Database credentials (Project settings -> Your apps -> Web app)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
# Must be the Realtime Database URL, not Firestore
VITE_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_APP_ID=

# Set to "true" to talk to a local `firebase emulators:start` instead
VITE_FIREBASE_EMULATOR=false

# Room key under /games in the database. Bump it to start a clean show.
VITE_GAME_ID=main
